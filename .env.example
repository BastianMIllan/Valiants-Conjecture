# Environment for a Valiant's Conjecture instance. See docs/SELF_HOSTING.md.
PUBLIC_URL=https://your-domain.com
PORT=3000
ADMIN_TOKEN=change-me-to-a-long-random-string
DATA_DIR=/data
# Number of reverse proxies in front of the server: the client address is read that many
# entries from the right of X-Forwarded-For. 1 for a single proxy.
TRUST_PROXY=1

# Branding
PROJECT_NAME=Valiant's Conjecture
TICKER=$PNP
PROJECT_SLUG=pnp
TOKEN_CA=
PUMP_URL=
X_URL=
TG_URL=

# The official effort: its public record says who proved what, by GitHub handle.
PNP_DATA=https://data.pequalnp.com/
PNP_REPO=open-goat/pequalnp-proofs
# Seconds between two fetches of the contributors record (default 180).
CONTRIBUTORS_REFRESH_SECONDS=180

# The team's own GitHub accounts: PNP_HANDLE, plus every other account the team proves with,
# comma-separated, in PNP_FORMER_HANDLES. They can never join as members, and their proofs are
# never credited or paid.
PNP_HANDLE=BastianMIllan
PNP_FORMER_HANDLES=PNPQED

# Required in production: a read-only GitHub token (a fine-grained token with no permissions).
# Without it GitHub allows about 60 gist checks an hour from the server, and a few people can
# block every sign-up.
GITHUB_TOKEN=
# Sign-up attempts allowed per connection per minute.
REGISTER_PER_MINUTE=10

# Team treasury (SOL). Create it with: npm run wallet  (or paste a 64-byte secret key here)
PAYOUT_SECRET_KEY=
PAYOUTS_ENABLED=0
SOLANA_RPC=https://api.mainnet-beta.solana.com
SOLANA_CLUSTER=mainnet-beta
PAYOUT_INTERVAL_MINUTES=10
PAYOUT_RESERVE_SOL=0.01
MIN_DISTRIBUTION_SOL=0.01
MIN_PAYOUT_SOL=0.001
PRIORITY_MICROLAMPORTS=20000

# Live mirror of the founder's operator dashboard (/live): the publisher's Ed25519 public key, base64 of its SPKI
# DER, as printed by npm run live:keygen (empty or off: the mirror is off). Snapshots accepted per connection per minute.
LIVE_PUBKEY=
LIVE_POSTS_PER_MINUTE=20

# Fee split shown on the site (percent)
SPLIT_CONTRIBUTORS=70
SPLIT_SPONSOR=20
SPLIT_OPS=10
