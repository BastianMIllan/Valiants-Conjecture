# Environment for a Valiant's Conjecture instance. See docs/SELF_HOSTING.md. PNP_HANDLE and GITHUB_TOKEN are required in production.
PUBLIC_URL=https://your-domain.com
PORT=3000
ADMIN_TOKEN=change-me-to-a-long-random-string
DATA_DIR=/data
TRUST_PROXY=1

# Branding
PROJECT_NAME=Valiant's Conjecture
TICKER=$PNP
PROJECT_SLUG=pnp
TOKEN_CA=
PUMP_URL=
X_URL=
TG_URL=

# The project's GitHub account: takes steps from the desk and opens every pull request.
PNP_HANDLE=BastianMIllan
# Classic personal access token of that account, scope: public_repo
GITHUB_TOKEN=
# Optional: your X handle, shown on the team's credit card at pequalnp.com
PR_X_HANDLE=

# Team treasury (SOL). Create it with: npm run wallet  (or paste a 64-byte secret key here)
PAYOUT_SECRET_KEY=
PAYOUTS_ENABLED=0
SOLANA_RPC=https://api.mainnet-beta.solana.com
SOLANA_CLUSTER=mainnet-beta
PAYOUT_INTERVAL_MINUTES=10
PAYOUT_RESERVE_SOL=0.01
MIN_DISTRIBUTION_SOL=0.01
MIN_PAYOUT_SOL=0.001
PRIORITY_MICROLAMPORTS=20000

# Fee split shown on the site (percent)
SPLIT_CONTRIBUTORS=70
SPLIT_SPONSOR=20
SPLIT_OPS=10
